# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Copilot/Claude workspace state
.claude/

# downloaded package archives
*.tgz

# Arquivos de segredo que NÃO começam com ".env" e por isso escapam do padrão
# acima. `env ARTHA (1).txt` carrega o token permanente da Meta e o app secret
# em texto puro: com o app secret, qualquer um forja X-Hub-Signature-256 e
# injeta mensagem no painel.
env*.txt
*.env.txt

# O template de ambiente PRECISA ser versionado — é ele que documenta quais
# variáveis existem. O `.env*` acima o pegava junto com os arquivos de segredo.
!.env.local.example
