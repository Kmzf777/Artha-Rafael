# ─── Meta / WhatsApp Cloud API ────────────────────────────
# Este arquivo lista QUAIS variáveis existem — nunca os valores. Todos os
# valores reais moram em `.env.local`, que é ignorado pelo git.
# Os ids ficam em: Meta → App → WhatsApp → API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
GRAPH_API_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
# Você inventa este valor e cola igual no painel da Meta.
WEBHOOK_VERIFY_TOKEN=

# ─── Supabase ─────────────────────────────────────────────
# A service role NUNCA leva prefixo NEXT_PUBLIC_: o browser não fala com o banco.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Acesso ao painel ─────────────────────────────────────
# Basic auth em TUDO menos o webhook. Medida mínima até o B5 (auth de verdade):
# sem isto, publicar o app deixa /api/campanhas aberto para qualquer um
# disparar para a base real. Vazio = painel liberado (só para localhost).
PAINEL_USUARIO=
PAINEL_SENHA=

# ─── Worker de disparo ────────────────────────────────────
CRON_SECRET=
# Conversas iniciadas por 24h. A Graph API não expõe o degrau para este token;
# 250 é o degrau conservador. Ver spec §7.3.
DISPARO_LIMITE_DIARIO=250

TENANT_NAME=artha
